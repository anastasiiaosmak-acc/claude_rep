{
  "permissions": {
    "allow": [
      "Bash(python3 notes.py:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-secrets.sh\"",
            "timeout": 10,
            "statusMessage": "Checking command against CLAUDE.md rules 2 and 7..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/py-syntax.sh\"",
            "timeout": 20,
            "statusMessage": "Parsing the file that was just written..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-brief.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
